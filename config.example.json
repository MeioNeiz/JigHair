{
  "active": "default",
  "visibility": {
    "mode": "always",
    "match": "process_name",
    "apps": ["cs2.exe", "notepad.exe"]
  },
  "presets": {
    "default": {
      "color": [0, 255, 0, 255],
      "outline_color": [0, 0, 0, 255],
      "outline": 1,
      "thickness": 2,
      "length": 10,
      "gap": 4,
      "dot": true,
      "dot_size": 2,
      "offset_x": 0,
      "offset_y": 0
    },
    "red-dot": {
      "color": [255, 40, 40, 255],
      "outline_color": [0, 0, 0, 255],
      "outline": 1,
      "thickness": 2,
      "length": 0,
      "gap": 0,
      "dot": true,
      "dot_size": 4,
      "offset_x": 0,
      "offset_y": 0
    }
  }
}
